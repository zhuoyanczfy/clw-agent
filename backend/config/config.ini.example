DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com

MAP_KEY=你的高德Web服务Key

# 天气查询城市编码（adcode），缺省 320100（南京）
WEATHER_ADCODE=320100

# API 鉴权令牌（APP 请求头 X-Api-Token，与 app/lib/config/app_config.dart 的 apiToken 保持一致；
# 部署时请生成随机值：python -c "import secrets; print(secrets.token_urlsafe(24))"）
API_TOKEN=请改成随机字符串

# 内容上传令牌（加载页图片/故事上传接口的请求头 X-Upload-Token，留空则禁用 API 上传）
UPLOAD_TOKEN=

# 好句配图 Pixabay API Key（https://pixabay.com/api/docs/ 申请，免费 100 请求/小时，支持中文关键词；留空则无配图）
PIXABAY_API_KEY=

# ============ 生产部署配置（[deploy] 节，本地开发保持 env=dev） ============
[deploy]
env=dev
# 生产环境必填：随机密钥（python -c "import secrets; print(secrets.token_urlsafe(50))"）
secret_key=
# 生产环境必填：你的域名，逗号分隔（如 foodmap.example.com,www.foodmap.example.com）
allowed_hosts=
# 服务器自建 MySQL 连接参数（生产环境使用）
db_host=127.0.0.1
db_port=3306
db_name=foodmap
db_user=foodmap
db_password=
